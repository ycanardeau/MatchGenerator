<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aigamo.MatchGenerator\Aigamo.MatchGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
